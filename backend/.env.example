# =============================================================================
# SAE INDIA — Cloud Secure WSS Relay Configuration
# =============================================================================

# Port to listen on (Render uses 10000; local dev default is 8443)
PORT=10000

# Environment mode
NODE_ENV=production

# Shared authentication secret token (must match frontend VITE_RELAY_TOKEN)
RELAY_TOKEN=saeindia_secret_token_2026

# Render keep-alive ping URL (prevents free instance spin-down)
KEEP_ALIVE_URL=https://dronebackend-ppgp.onrender.com
RENDER_EXTERNAL_URL=https://dronebackend-ppgp.onrender.com
